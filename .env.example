# Brio local development environment
# Update values as needed before first run

# Security
SECRET="change-this-secret"

# Admin bootstrap (used by cli.js bootstrap)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"

# Database (SQLite default for local dev)
DB_CLIENT="sqlite3"
DB_FILENAME="../database/database.sqlite"

# App/Public URL
PUBLIC_URL="http://localhost:8055"

# When running @brio/api from /api, load extensions from monorepo root
EXTENSIONS_PATH="../extensions"

KEY="change-this-key"

# Telemetry
TELEMETRY=false

# AGE
AGE_IDENTITY=
AGE_RECIPIENT=

# Container publish credentials (GHCR)
GHCR_USER=""
GHCR_TOKEN=""