		"@vue/test-utils": "2.3.2",
		"axios": "1.3.6",
		"typescript": "5.0.4",
		"vitest": "0.30.1"
	},
	"dependencies": {
		"@brio/constants": "workspace:*",
		"@brio/utils": "workspace:*",
		"lodash-es": "4.17.21",
		"nanoid": "4.0.2",
		"vue": "3.2.47"
	}
