{
	"name": "@brio/composables",
	"version": "9.26.0",
	"type": "module",
	"scripts": {
		"build": "echo 'No build needed - Bun runs TypeScript natively'",
		"dev": "echo 'No dev build needed - Bun runs TypeScript natively'",
		"test": "vitest --watch=false"
	},
	"description": "Shared Vue composables for Brio use",
	"repository": {
		"type": "git",
		"url": "https://github.com/nicobrio/brio.git",
		"directory": "packages/composables"
	},
	"funding": "https://github.com/nicobrio/brio?sponsor=1",
	"license": "GPL-3.0",
	"author": "Rijk van Zanten <rijkvanzanten@me.com>",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"main": "src/index.ts",
	"types": "src/index.ts",
	"files": [
		"dist",
		"!**/*.test.{js,d.ts}"
	],
	"publishConfig": {
