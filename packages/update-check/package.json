{
	"name": "@brio/update-check",
	"version": "9.26.0",
	"type": "module",
	"scripts": {
		"build": "echo 'No build needed - Bun runs TypeScript natively'",
		"dev": "echo 'No dev build needed - Bun runs TypeScript natively'",
		"test": "vitest --watch=false"
	},
	"description": "Check if an update is available for a given package",
	"repository": {
		"type": "git",
		"url": "https://github.com/nicobrio/brio.git",
		"directory": "packages/update-check"
	},
	"funding": "https://github.com/nicobrio/brio?sponsor=1",
	"license": "GPL-3.0",
	"author": "Rijk van Zanten <rijkvanzanten@me.com>",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"main": "src/index.ts",
	"types": "src/index.ts",
	"files": [
		"dist",
		"!**/*.d.ts?(.map)"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"semver": "7.8.5"
	},
	"devDependencies": {
		"@brio/tsconfig": "0.0.7",
		"@ngneat/falso": "6.4.0",
		"@types/semver": "7.8.0",
		"@vitest/coverage-c8": "0.30.1",
		"typescript": "5.0.4",
		"vitest": "3.2.6"
	}
}
